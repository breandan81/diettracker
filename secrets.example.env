# Copy to secrets.env (gitignored) and edit.
#   cp secrets.example.env secrets.env

HOST=0.0.0.0
PORT=8511

# Local bootstrap uses SQLite under ./data/
# For Postgres (docker compose or system install):
# DATABASE_URL=postgresql+psycopg://trend:trend@127.0.0.1:5433/trend_multi
# DATABASE_URL=sqlite:///./data/trend_multi.db

SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USER_IDS=

XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_IMAGINE_MODEL=grok-imagine-image-2.0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8511/api/auth/google/callback

DAILY_LIMIT_COACH=20
DAILY_LIMIT_VISION=10
DAILY_LIMIT_IMAGINE=5
